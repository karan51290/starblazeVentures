---
layout: layouts/page.njk
title: Contact | StarBlaze Ventures
description: Get in touch with StarBlaze Ventures — C8/1, Gr. Floor, Sector 4, Eldeco Estate One, Panipat.
---
{% from "macros/image-placeholder.njk" import imagePlaceholder %}
{% set enquiryUrl = business.contact.phone | whatsappLink("Hi StarBlaze, I'd like to talk about my business.") %}

<section class="page-hero">
  <span class="eyebrow">Contact us</span>
  <h1>Let's Talk About Your Business</h1>
  <p class="lede">Tell us a bit about what you need. We'll get back to you with next steps, no generic sales pitch.</p>
</section>

<div class="contact-grid">
  <div class="contact-grid__main">
    <div class="contact-methods">
      <a class="contact-card contact-card--primary" href="{{ enquiryUrl }}" target="_blank" rel="noopener">
        <span class="contact-card__label">WhatsApp</span>
        <strong>Message us on WhatsApp</strong>
        <span>Usually the fastest way to reach us</span>
      </a>
      <a class="contact-card" href="tel:{{ business.contact.phone }}">
        <span class="contact-card__label">Call</span>
        <strong>{{ business.contact.phoneDisplay }}</strong>
        <span>Tap to call</span>
      </a>
      {% if business.contact.email %}
      <a class="contact-card" href="mailto:{{ business.contact.email }}">
        <span class="contact-card__label">Email</span>
        <strong>{{ business.contact.email }}</strong>
        <span>We'll reply by email</span>
      </a>
      {% endif %}
      <a class="contact-card" href="{{ business.contact.mapsUrl }}" target="_blank" rel="noopener">
        <span class="contact-card__label">Visit</span>
        <strong>{{ business.contact.address.line1 }}, {{ business.contact.address.city }}, {{ business.contact.address.state }}</strong>
        <span>View on Google Maps</span>
      </a>
    </div>

    <section class="detail-section">
      <h2>Send us a message</h2>
      <p>Fill this in and we'll open WhatsApp with your message ready to send.</p>
      <form class="contact-form" id="contact-form" data-phone="{{ business.contact.phone | whatsappDigits }}">
        <label>Your name
          <input type="text" name="name" required autocomplete="name">
        </label>
        <label>I'm interested in
          <select name="topic">
            <option value="">Not sure yet</option>
            <optgroup label="Services">
              {% for service in services %}<option>{{ service.title }}</option>{% endfor %}
            </optgroup>
            <optgroup label="Store">
              {% for product in products %}<option>{{ product.title }}</option>{% endfor %}
            </optgroup>
          </select>
        </label>
        <label>Message
          <textarea name="message" rows="4" required></textarea>
        </label>
        <button type="submit" class="btn btn--pill">Send on WhatsApp</button>
      </form>
    </section>
  </div>

  <aside class="contact-grid__side">
    {{ imagePlaceholder("StarBlaze Ventures office", "4/3", "/assets/images/contact-office.jpg") }}
    <div class="side-card">
      <h2>Find us</h2>
      <p>{{ business.contact.address.line1 }}, {{ business.contact.address.city }}, {{ business.contact.address.state }}</p>
      <p><a href="{{ business.contact.mapsUrl }}" target="_blank" rel="noopener">Open in Google Maps &rarr;</a></p>
    </div>
  </aside>
</div>
<script src="/assets/js/contact-form.js" defer></script>
