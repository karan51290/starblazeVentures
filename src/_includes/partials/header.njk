{% from "macros/button.njk" import button %}
<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/">{{ business.brand.name }}</a>
    <nav class="site-nav" aria-label="Primary">
      <div class="site-nav__links">
        <a href="/" class="{% if page.url == '/' %}is-active{% endif %}">Home</a>
        <a href="/about/" class="{% if page.url == '/about/' %}is-active{% endif %}">About</a>
        <a href="/services/" class="{% if page.url.startsWith('/services/') %}is-active{% endif %}">Services</a>
        {% if business.featureFlags.portfolioEnabled %}
        <a href="/portfolio/" class="{% if page.url == '/portfolio/' %}is-active{% endif %}">Portfolio</a>
        {% endif %}
        {% if business.featureFlags.storeEnabled %}
        <a href="/store/" class="{% if page.url.startsWith('/store/') %}is-active{% endif %}">Store</a>
        {% endif %}
      </div>
      <a class="btn btn--primary btn--nav" href="/contact/">Contact Us</a>
    </nav>
  </div>
</header>
