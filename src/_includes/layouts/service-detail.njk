---
layout: layouts/base.njk
---
{% from "macros/image-placeholder.njk" import imagePlaceholder %}
{% from "macros/faq.njk" import faq %}
{% set enquiryUrl = business.contact.phone | whatsappLink("want to enquire about " + (page.url | absoluteUrl(business.site.url))) %}
<article class="page-container service-detail">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> <span>&rsaquo;</span> <a href="/services/">Services</a> <span>&rsaquo;</span> <span aria-current="page">{{ service.title }}</span>
  </nav>

  <div class="pdp">
    <div class="pdp__gallery">
      {{ imagePlaceholder(service.imageAlt, "4/3", service.image) }}
    </div>

    <div class="pdp__buybox">
      <span class="badge">Service</span>
      <h1>{{ service.title }}</h1>
      <p class="pdp__short">{{ service.summary }}</p>

      {% if service.benefits and service.benefits.length %}
      <ul class="check-list check-list--compact">
        {% for benefit in service.benefits %}<li>{{ benefit }}</li>{% endfor %}
      </ul>
      {% endif %}

      <div class="product-detail__actions">
        <a class="btn btn--pill" href="{{ enquiryUrl }}" target="_blank" rel="noopener">Contact Us</a>
      </div>
    </div>
  </div>

  <div class="detail-columns">
    <div class="detail-columns__main">
      <section class="detail-section detail-section--first">
        <h2>About this service</h2>
        <div class="service-detail__body">{{ service.body | markdownify | safe }}</div>
      </section>

      {% if service.process and service.process.length %}
      <section class="detail-section">
        <h2>How it works</h2>
        <ol class="steps">
          {% for step in service.process %}
          <li class="steps__item">
            <h3>{{ step.title }}</h3>
            <p>{{ step.text }}</p>
          </li>
          {% endfor %}
        </ol>
      </section>
      {% endif %}

      {{ faq(service.faq) }}
    </div>

    <aside class="detail-columns__side">
      <div class="side-card side-card--accent">
        <h2>Interested in {{ service.title }}?</h2>
        <p>Message us on WhatsApp and we will get back to you.</p>
        <a class="btn btn--pill" href="{{ enquiryUrl }}" target="_blank" rel="noopener">Contact Us</a>
      </div>

      {% if service.related and service.related.length %}
      <div class="side-card">
        <h2>Related services</h2>
        <ul class="related-list">
          {% for item in activeServices %}
            {% if item.slug in service.related %}
            <li><a href="/services/{{ item.slug }}/">{{ item.title }}</a></li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
      {% endif %}
    </aside>
  </div>
</article>
