---
layout: layouts/base.njk
---
{% from "macros/image-placeholder.njk" import imagePlaceholder %}
{% from "macros/faq.njk" import faq %}
{% from "macros/card.njk" import card %}
{% set enquiryUrl = business.contact.phone | whatsappLink("want to enquire about " + (page.url | absoluteUrl(business.site.url))) %}
{% set categoryLabels = { ebook: "eBook", platform: "Platform", software: "Software", service: "Managed service", plr: "PLR" } %}
<article class="page-container product-detail">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> <span>&rsaquo;</span> <a href="/store/">Store</a> <span>&rsaquo;</span> <span aria-current="page">{{ product.title }}</span>
  </nav>

  <div class="pdp">
    <div class="pdp__gallery">
      {{ imagePlaceholder(product.imageAlt, "4/3", product.image) }}
    </div>

    <div class="pdp__buybox">
      <span class="badge">{{ categoryLabels[product.category] or product.category }}</span>
      <h1>{{ product.title }}</h1>
      <p class="product-detail__price">
        {% if product.priceDisplayOverride %}{{ product.priceDisplayOverride }}{% elif product.price %}&#8377;{{ product.price }}{% endif %}
      </p>
      <p class="pdp__short">{{ product.shortDescription }}</p>

      {% if product.highlights and product.highlights.length %}
      <ul class="check-list check-list--compact">
        {% for item in product.highlights | batch(4) | first %}<li>{{ item }}</li>{% endfor %}
      </ul>
      {% endif %}

      <div class="product-detail__actions">
        {% if business.featureFlags.buyEnabled and product.buyNowUrl %}
          <a class="btn btn--pill" href="{{ product.buyNowUrl }}">Buy Now</a>
        {% else %}
          <button type="button" class="btn btn--pill" data-buy-now>Buy Now</button>
        {% endif %}
        <a class="btn btn--secondary btn--pill-outline" href="{{ enquiryUrl }}" target="_blank" rel="noopener">Contact Us</a>
      </div>
    </div>
  </div>

  <div class="detail-columns">
    <div class="detail-columns__main">
      <section class="detail-section detail-section--first">
        <h2>About this product</h2>
        <div class="product-detail__body">{{ product.description | markdownify | safe }}</div>
      </section>

      {% if product.highlights and product.highlights.length > 4 %}
      <section class="detail-section">
        <h2>More features</h2>
        <ul class="check-list">
          {% for item in product.highlights %}{% if loop.index > 4 %}<li>{{ item }}</li>{% endif %}{% endfor %}
        </ul>
      </section>
      {% endif %}

      {{ faq(product.faq) }}
    </div>

    <aside class="detail-columns__side">
      {% if product.facts and product.facts.length %}
      <div class="side-card">
        <h2>Product details</h2>
        <dl class="facts facts--stacked">
          {% for fact in product.facts %}
          <div class="facts__row"><dt>{{ fact.label }}</dt><dd>{{ fact.value }}</dd></div>
          {% endfor %}
        </dl>
      </div>
      {% endif %}

      {% if product.audience %}
      <div class="side-card">
        <h2>Who it's for</h2>
        <p>{{ product.audience }}</p>
      </div>
      {% endif %}

      <div class="side-card side-card--accent">
        <h2>Questions?</h2>
        <p>Ask us anything about this product on WhatsApp.</p>
        <a class="btn btn--pill" href="{{ enquiryUrl }}" target="_blank" rel="noopener">Contact Us</a>
      </div>
    </aside>
  </div>

  <section class="detail-section">
    <h2>More from the store</h2>
    <div class="card-grid">
      {% for other in products %}
        {% if other.slug != product.slug %}
          {{ card(other.title, other.shortDescription, "/store/" + other.slug + "/", other.imageAlt, "View product", other.image) }}
        {% endif %}
      {% endfor %}
    </div>
  </section>
</article>

<dialog class="buy-dialog" id="buy-dialog" aria-labelledby="buy-dialog-title">
  <h2 id="buy-dialog-title">Coming soon</h2>
  <p>Online purchase is not available yet. Please click <strong>Contact Us</strong> for more details.</p>
  <div class="buy-dialog__actions">
    <a class="btn btn--pill" href="{{ enquiryUrl }}" target="_blank" rel="noopener">Contact Us</a>
    <button type="button" class="btn btn--secondary btn--pill-outline" data-buy-close>Close</button>
  </div>
</dialog>
<script src="/assets/js/buy-modal.js" defer></script>
